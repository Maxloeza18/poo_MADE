# ==========================================================
# .gitignore — Proyecto Python (Programación Orientada a Objetos)
# Basado en la plantilla oficial de github/gitignore
# ==========================================================

# --- Bytecode / archivos compilados ---
__pycache__/
*.py[cod]
*$py.class

# --- Extensiones en C ---
*.so

# --- Distribución / empaquetado ---
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- PyInstaller ---
*.manifest
*.spec

# --- Logs de instaladores ---
pip-log.txt
pip-delete-this-directory.txt

# --- Reportes de pruebas unitarias / cobertura ---
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# --- Traducciones ---
*.mo
*.pot

# --- Django ---
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# --- Flask ---
instance/
.webassets-cache

# --- Scrapy ---
.scrapy

# --- Documentación Sphinx ---
docs/_build/

# --- PyBuilder ---
.pybuilder/
target/

# --- Jupyter Notebook ---
.ipynb_checkpoints

# --- IPython ---
profile_default/
ipython_config.py

# --- pyenv ---
.python-version

# --- pipenv ---
Pipfile.lock

# --- poetry ---
poetry.lock

# --- pdm ---
.pdm.toml

# --- PEP 582 ---
__pypackages__/

# --- Celery ---
celerybeat-schedule
celerybeat.pid

# --- SageMath ---
*.sage.py

# --- Entornos virtuales ---
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# --- Spyder ---
.spyderproject
.spyproject

# --- Rope ---
.ropeproject

# --- mkdocs ---
/site

# --- mypy ---
.mypy_cache/
.dmypy.json
dmypy.json

# --- Pyre ---
.pyre/

# --- pytype ---
.pytype/

# --- Cython ---
cython_debug/

# --- Editores / IDE ---
.idea/
.vscode/
*.swp

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini
